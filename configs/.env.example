# AIGC Pool —— 环境变量样例。
# 复制为项目根的 .env 后按需修改。**本文件只放占位符，绝不放真实凭证。**
# 所有变量统一 AIGC_ 前缀，由 internal/config 读取。

# ── HTTP ─────────────────────────────────────────────────────────────
AIGC_HTTP_ADDR=:8080
AIGC_SHUTDOWN_TIMEOUT=15s

# ── MySQL（必填，无默认值）───────────────────────────────────────────
# go-sql-driver/mysql DSN 形态：user:password@tcp(host:port)/dbname?params
AIGC_MYSQL_DSN=aigc:CHANGE_ME@tcp(127.0.0.1:3306)/aigc_pool?parseTime=true&charset=utf8mb4&loc=UTC

# ── 存储 ─────────────────────────────────────────────────────────────
# L3 资产落盘根目录。上游产物在任务成功那一刻转存到这里，库里只存我们自己的 key。
AIGC_STORAGE_ROOT=./data/storage

# ── 鉴权 ─────────────────────────────────────────────────────────────
# AIGC_JWT_SECRET_ENV 存的是**变量名**，不是密钥；真正的密钥放在它指向的那个变量里。
# 与 Provider.credential_ref 同一套思路：密钥只从 env 读，不入库、不进代码。
AIGC_JWT_SECRET_ENV=AIGC_JWT_SECRET
AIGC_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
AIGC_JWT_TTL=720h

# ── L2 执行层 ────────────────────────────────────────────────────────
AIGC_WORKER_CONCURRENCY=4
AIGC_POLL_INTERVAL=12s

# ── 供应商凭证（变量名对应 providers.credential_ref）────────────────
# 本地无真实凭证时把模型配成 protocol_family=mock，全链路照样能跑通。
AIGC_PROVIDER_ARK_KEY=CHANGE_ME
AIGC_PROVIDER_OPENAI_KEY=CHANGE_ME
AIGC_PROVIDER_GOOGLE_KEY=CHANGE_ME
