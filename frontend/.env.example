# 复制成 .env.local 后按需修改。这里不放任何真实凭证 —— 模型 Key 由后端统一持有。

# true  = 使用内置内存 mock 后端（无需启动 Go 后端即可跑通全链路）
# false = 使用真后端
VITE_USE_MOCK=true

# 真后端基址。默认 /api，由 vite dev server 代理到 VITE_API_PROXY_TARGET
VITE_API_BASE=/api

# dev server 代理目标（仅 VITE_USE_MOCK=false 时生效）
VITE_API_PROXY_TARGET=http://localhost:8080
